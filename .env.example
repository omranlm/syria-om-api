# Copy to .env and adjust. Docker Compose reads DB_PASSWORD; the API reads the rest.
PORT=3000
DB_PASSWORD=syriaom
# Used when running the API outside Docker (inside Compose it is set to the db service):
DATABASE_URL=postgres://syriaom:syriaom@localhost:5433/syriaom

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_DAYS=30

# SMS: "fake" logs the code instead of sending it and always accepts FAKE_OTP_CODE. With the fake provider,
# SMS sign-in is switched off unless ALLOW_FAKE_OTP=true (local development only: anyone could sign in to
# any number). The app signs in with phone + PIN or Telegram.
SMS_PROVIDER=fake
FAKE_OTP_CODE=123456
ALLOW_FAKE_OTP=false
OTP_TTL_S=300
DEFAULT_COUNTRY=SY

# Default admin, created on first start (the password is only set when the user does not exist yet).
ADMIN_PHONE=+963000000000
ADMIN_PASSWORD=ChangeMe123!

# Sign-in with a Telegram bot (create it with @BotFather). Leave empty to hide the option.
# The bot uses long polling: no public HTTPS address or webhook is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Tracking data older than this is purged nightly.
RETENTION_YEARS=5
