{
  "name": "syria-om-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Admin dashboard of the Syria Organic Maps API (React + Vite), built into ../public/admin",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.23",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
